# Hammerfile for lux-fw - run via `hammer <task>` (see lux-hammer gem).
# Replaces the legacy Rakefile.

task :test do
  desc 'Run the Minitest suite (one ruby process per spec folder, plugin specs included)'
  alt :t
  opt :folder,   desc: 'Run a single spec folder (e.g. lux_tests, or plugins/pdf/spec)'
  opt :isolated, type: :boolean, desc: 'Every spec in a fresh ruby process (max isolation, slow)'

  proc do |o|
    # each plugin ships its own spec/ folder next to the code it tests
    folders = Dir.glob('spec/*_tests').sort + Dir.glob('plugins/*/spec').sort
    run_folder = ->(dir) { system %(bundle exec ruby -Ilib -Ispec -e "Dir.glob('#{dir}/**/*_spec.rb').sort.each { |f| require_relative f }") }

    # one-folder mode
    if o[:folder]
      dir = o[:folder].include?('/') ? o[:folder] : "spec/#{o[:folder]}"
      next error("FAILED folder: #{dir}") unless run_folder.(dir)
      next
    end

    # isolated mode - every spec in its own ruby
    if o[:isolated]
      failed = []
      folders.flat_map { Dir.glob("#{_1}/**/*_spec.rb").sort }.each do |f|
        ok = system "bundle exec ruby -Ilib -Ispec #{f} > /dev/null 2>&1"
        print ok ? '.' : 'F'
        failed << f unless ok
      end
      puts
      error "FAILED: #{failed.join("\n        ")}" if failed.any?
      next
    end

    # default - folder-isolated
    failed = []
    folders.each do |dir|
      next if Dir.glob("#{dir}/**/*_spec.rb").empty?
      say.yellow "== #{dir} =="
      failed << dir unless run_folder.(dir)
    end
    error "FAILED folders: #{failed.join(', ')}" if failed.any?
  end
end

task :version do
  desc 'Print the build version'
  proc do
    require_relative 'lib/lux/version'
    say Lux::Version.string
  end
end

task :deploy do
  desc 'Test, stamp + tag + push the version (vstamp count --release), then push the gem to RubyGems'
  proc do
    hammer :test
    sh 'vstamp count --release'
    # ask a fresh ruby: the gemspec honours LUX_VERSION and the stamp vstamp just wrote
    version  = `ruby -e "print Gem::Specification.load('lux-fw.gemspec').version"`.strip
    gem_file = "lux-fw-#{version}.gem"
    sh "gem build lux-fw.gemspec -o #{gem_file}"
    sh "gem push #{gem_file}"
    File.delete(gem_file)
  end
end

task :console do
  desc 'Start pry console with lux-fw loaded'
  alt :c

  proc do
    $LOAD_PATH.unshift File.expand_path('lib')
    require 'overload/thread_simple'
    require 'lux/loader'
    require 'pry'
    say "Lux #{Lux::Version.string} loaded from #{Dir.pwd}", :green
    Pry.start
  end
end
