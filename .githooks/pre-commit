#!/bin/sh
# Stamp .version with the commit count this commit lands on (371 -> 3.7.1)
# via vstamp (github.com/dux/vstamp). Installed with
# `git config core.hooksPath .githooks` (see `hammer hooks`).
set -e

# detached HEAD (rebase, cherry-pick): leave .version alone
branch=$(git symbolic-ref -q --short HEAD) || exit 0

command -v vstamp >/dev/null || {
  echo 'pre-commit: vstamp not found, install from https://github.com/dux/vstamp' >&2
  exit 1
}

vstamp count --next --branch "$branch" >/dev/null
git add .version
