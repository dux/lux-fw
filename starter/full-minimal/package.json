{
  "private": true,
  "type": "module",
  "name": "{{app}}",
  "version": "1.0.0",
  "devDependencies": {
    "fez": "file:.gems/fez",
    "postwind": "file:.gems/postwind",
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "coffeescript": "^2.7.0",
    "rollup": "^4.59.0",
    "rollup-plugin-coffee-script": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "sass": "^1.91.0",
    "svelte": "3.59.2",
    "svelte-preprocess": "^6.0.2"
  },
  "scripts": {
    "build": "bundle exec lux assets:auto && bundle exec lux assets:build",
    "prod": "bundle exec lux assets:config && NODE_PRESERVE_SYMLINKS=1 bun run rollup -c",
    "dev": "bundle exec lux assets:config && NODE_PRESERVE_SYMLINKS=1 bun run rollup -cw"
  }
}
