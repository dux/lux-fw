!!!
%html{ lang: 'en' }
  %head
    %meta{ charset: 'utf-8' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
    %title= '{{App}}'
    -# emits <script id="lux-state"> - window.app.current.user for app-nav.fez
    = lux.browser.window_script
    %script{ src: 'https://cdn.jsdelivr.net/npm/postwind@0.6.1/src/postwind.js' }
    :javascript
      PostWind.init({ tailwind: true });
    %script{ src: 'https://cdn.jsdelivr.net/npm/@dinoreic/fez@0.6.0/dist/fez.js' }
    %script{ fez: '/components/app-nav.fez' }
  %body.bg-slate-50.text-slate-900.font-sans.antialiased
    .max-w-5xl.mx-auto.px-6
      %header.flex.flex-wrap.items-center.justify-between.gap-4.py-6.border-b.border-slate-200
        %a.font-bold.text-xl.tracking-tight{ href: '/' } {{App}}
        %app-nav
      -# the pjax container. Fez binds its Pjax navigation only when the page
      -# has a `.pjax` (or <pjax>) node carrying an id; links then swap this
      -# node instead of reloading the document.
      %main#page.pjax.py-12|20
        = yield
      %footer.py-6.border-t.border-slate-200.text-sm.text-slate-500
        Built with Lux, PostWind and Fez.
