# lgem -> local gem. Resolved from ./.libs/<name> when present (dev: symlinks
# to the gem checkouts), else from RubyGems, pinned to the version that ran
# `lux new` (no pin for a dev build). Anchored to __dir__, never the cwd:
# anything that sets BUNDLE_GEMFILE and runs from elsewhere would otherwise
# miss ./.libs.
def lgem name, *requirements
  local = File.join(__dir__, '.libs', name)

  if File.directory?(local)
    gem name, path: local
  else
    gem name, *requirements
  end
end

###

source 'https://rubygems.org'

lgem 'lux-fw'{{lux_fw_pin}}

gem 'puma'
