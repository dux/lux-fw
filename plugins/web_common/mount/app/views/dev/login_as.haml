:ruby
  raise Lux.error.not_found unless UserSession.impersonate?

.mx-auto{ style: 'max-width: 800px' }
  .mt-5
    %h1.mb-1
      Login as
      - if user
        %small
          &sdot;
          = user.email

          - if user.is_admin?
            &sdot;
            %ui-btn{ href: '/admin' } admin

    .mb-5

    %ui-search

    .mb-5

    = table User.desc(:updated_at).xlike(params[:q], :name, :email) do |t|
      - t.href {|user| UserSession.login_link(user, path: request.path) }
      - t.col as: :avatar
      - t.col :full_name
      - t.col :is_admin?, as: :boolean
