:ruby
  # dev pages of web_common and of the app (app/views/dev is optional)
  @files = Lux.root.files('app/views/dev/*.*').map { _1.basename.to_s.split('.').first }.reject { _1.start_with?('_') }.uniq - %w[layout root]

= Lux.ctx.render_html do |el|
  = el.assets :app

  = el.body do
    = render '/dev/_dev_menu'
    .m-5
      .mb-5
        .btn{ href: '/' } /
        .btn{ href: '/dev' } /dev
        - for file in @files
          .btn{ href: "/dev/#{file}" }= file

      = yield
