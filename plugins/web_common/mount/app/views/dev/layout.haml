:ruby
  @files = Dir
    .files('app/views/dev')
    .reject {|f| f.start_with?('_') }
    .map {|f| f.split('.').first }
  @files -= ['layout', 'root']

= lux.render_html do |el|
  = el.assets :app

  = el.body do
    = render '/dev/_dev_menu'
    .m-5
      .mb-5
        .btn{ href: '/' } /
        .btn{ href: '/dev' } /dev
        - for file in @files
          .btn{ href: "/dev/#{file}" }= file

      = yield
