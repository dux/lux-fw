:ruby
  # dev pages of web_common and of the app (app/views/dev is optional)
  @files = ["#{Lux::Plugin.get(:web_common).folder}/mount/app/views/dev", 'app/views/dev']
    .select { Dir.exist?(_1) }
    .flat_map { Dir.files(_1) }
    .reject {|f| f.start_with?('_') }
    .map {|f| f.split('.').first }
    .uniq
  @files -= ['layout', 'root']

= lux.render_html do |el|
  = el.assets :app

  = el.body do
    = render '/dev/_dev_menu'
    .m-5
      .mb-5
        .btn{ href: '/' } /
        .btn{ href: '/dev' } /dev
        - for file in @files
          .btn{ href: "/dev/#{file}" }= file

      = yield
