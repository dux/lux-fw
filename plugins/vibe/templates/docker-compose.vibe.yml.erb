# Vibe coding harness - generated by `lux docker:vibe:init` (lux-fw plugins/vibe).
# Used together with the base stack, from the app root:
#   docker compose --project-directory . -f <%= docker_dir %>/docker-compose.yml -f <%= docker_dir %>/docker-compose.vibe.yml \
#                  [-f <%= docker_dir %>/docker-compose.override.yml] up
# which is what `lux docker:vibe:run` does (paths below are relative to the app root).
#
# One extra service next to app + db:
#   vibe  the harness page on :4000 (Sinatra, lux docker:vibe:server) and a headless
#         `opencode serve` on 127.0.0.1:4096 inside the container, both working on
#         the same ./ checkout the app serves. opencode's state (sessions) lives in
#         ./local/opencode so it survives container restarts.
#
# The docker socket is mounted here, and only here, for the "hard restart" button
# (docker restart of the app container). The agent's shell runs in this container
# too - keep that in mind: whoever can drive the chat can drive the socket.

services:
  vibe:
    # profile: `lux docker:run` loads this file too (so a personal override may add
    # vibe volumes) but only `--profile vibe` (lux docker:vibe:run) starts the service
    profiles: ["vibe"]
    build:
      context: .
      dockerfile: <%= docker_dir %>/Dockerfile.vibe
    init: true
    stdin_open: true
    tty: true
    depends_on:
      - <%= app_service %>
    command: bash <%= docker_dir %>/entrypoint.vibe.sh
    ports:
      - "4000:4000"
    env_file:
      - .env                    # OPENROUTER_API_KEY, VIBE_MODEL, VIBE_GIT_NAME/EMAIL
    environment:
      VIBE_ROOT: /app
      VIBE_BRANCH: <%= branch %>
      VIBE_MAIN: <%= main %>
      VIBE_PORT: "4000"
      VIBE_APP_URL: http://localhost:3000          # what the browser iframes (host side)
      VIBE_APP_HEALTH_URL: http://<%= app_service %>:3000   # what the harness pings (compose network)
      VIBE_APP_SERVICE: <%= app_service %>
      VIBE_OC_URL: http://127.0.0.1:4096
      OPENCODE_CONFIG: /app/<%= docker_dir %>/vibe/opencode.json
      COMPOSE_PROJECT_NAME: <%= app_name %>
      BUNDLE_PATH: /app/local/bundle
      BUN_INSTALL_CACHE_DIR: /app/local/bun-cache
      GIT_TERMINAL_PROMPT: "0"
    volumes:
      - .:/app                                    # the same live checkout the app serves
      - ./local/gems:/app/.gems                   # same dep layout as the app service
      - ./local/gems:/gems
      - ./local/node_modules:/app/node_modules    # fez.js for the harness page
      - ./local/opencode:/root/.local/share/opencode   # sessions, snapshots
      - /var/run/docker.sock:/var/run/docker.sock      # hard restart + app logs
      - ~/.ssh:/root/.ssh:ro                           # git push over ssh (commit identity comes from VIBE_GIT_* in .env)
