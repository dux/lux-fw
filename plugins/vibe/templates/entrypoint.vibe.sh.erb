#!/usr/bin/env bash
# Vibe container boot - generated by `lux docker:vibe:init` (lux-fw plugins/vibe).
#
# Runs two processes on the same /app checkout the app container serves:
#   [oc]   opencode serve on 127.0.0.1:4096 (the agent; <%= docker_dir %>/vibe/opencode.json)
#   [vibe] lux docker:vibe:server on :4000 (the harness page + api + proxy to opencode)
# Both log to stdout with a prefix so `docker compose logs vibe` reads as one stream.
# If either dies the container exits, so compose restarts/reports it instead of
# leaving a half-working harness behind.
set -euo pipefail

cd /app

say() { printf '\n\033[35m==> %s\033[0m\n' "$*"; }

mkdir -p log tmp local/opencode

# the checkout is owned by the host uid; git refuses to touch it otherwise
git config --global --add safe.directory /app
git config --global user.name  "${VIBE_GIT_NAME:-vibe}"            >/dev/null 2>&1 || true
git config --global user.email "${VIBE_GIT_EMAIL:-vibe@localhost}" >/dev/null 2>&1 || true

# Gems are shared with the app container (BUNDLE_PATH=/app/local/bundle). The app
# boots first and installs them; wait for that rather than racing it, then make
# sure nothing is missing on our side.
say 'waiting for gems (shared with the app service)'
for _ in $(seq 1 120); do
  if bundle check >/dev/null 2>&1; then break; fi
  sleep 2
done
bundle check >/dev/null 2>&1 || bundle install

# job control: every background pipeline gets its own process group, so one
# kill takes the process and its sed prefixer down together
set -m

say 'starting opencode on 127.0.0.1:4096'
opencode serve --hostname 127.0.0.1 --port 4096 --print-logs 2>&1 | sed -u 's/^/[oc]   /' &
OC=$!

say 'starting vibe harness on http://localhost:4000'
bundle exec lux docker:vibe:server 2>&1 | sed -u 's/^/[vibe] /' &
VIBE=$!

cleanup() {
  trap - EXIT TERM INT
  kill -- -"$OC" -"$VIBE" 2>/dev/null || true
}
trap cleanup EXIT TERM INT

# first one to exit ends the container
wait -n "$OC" "$VIBE" || true
say 'a vibe process exited, shutting down'
