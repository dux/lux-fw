# Vibe harness image - generated by `lux docker:vibe:init` (lux-fw plugins/vibe).
# Toolchain only: ruby for the Sinatra harness (shares the app's BUNDLE_PATH volume),
# bun + opencode for the agent, git, and a docker CLI that talks to the mounted socket
# for the hard-restart button. Code, gems and node_modules are mounted at runtime.
FROM ruby:<%= ruby_version %>

RUN apt-get update -y && \
    apt-get install -y git curl ca-certificates ripgrep libpq-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# docker CLI only (no daemon): `docker restart` / `docker logs` over /var/run/docker.sock
ARG DOCKER_CLI_VERSION=27.5.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/$(uname -m)/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker && rm -rf /tmp/docker

# bun runs opencode
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

RUN bun add -g opencode-ai@<%= opencode_version %>

ENV BUNDLER_VERSION=<%= bundler_version %>
RUN gem install bundler --version "$BUNDLER_VERSION"

WORKDIR /app

EXPOSE 4000
