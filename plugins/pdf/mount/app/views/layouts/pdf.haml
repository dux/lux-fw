!!!
%html{ lang: 'hr' }
  %head
    %meta{ charset: 'UTF-8' }
    %title= @pdf_title || 'PDF Document'
    / Paged.js paginates the page into real A4 boxes - on screen (preview) and in
    / headless Chrome (PdfGenerator). Same engine both sides => identical output.
    / window.pagedReady is the signal PdfGenerator waits on before printing.
    :javascript
      // loading="lazy" deadlocks pagination: Paged.js has to measure an image
      // before it can break the page around it, but Chrome will not fetch a lazy
      // image far below the fold - and pagination is what would bring it into
      // view. Nothing is ever offscreen on a printed page, so force eager. The
      // observer is installed before <body> is parsed, so it catches every image
      // as it arrives, including the copies Paged.js clones into its page boxes.
      new MutationObserver(records => {
        for (const record of records) {
          for (const node of record.addedNodes) {
            if (node.nodeType !== 1) continue
            if (node.tagName === 'IMG') node.loading = 'eager'
            node.querySelectorAll?.('img[loading="lazy"]').forEach(img => { img.loading = 'eager' })
          }
        }
      }).observe(document.documentElement, { childList: true, subtree: true })

      window.PagedConfig = {
        auto: true,
        before () {
          document.querySelectorAll('img[loading="lazy"]').forEach(img => { img.loading = 'eager' })
        },
        after () {
          window.pagedReady = true
          // Title (and thus the download filename) follows the document's H1.
          const h1 = document.querySelector('h1')
          if (h1) document.title = h1.textContent.trim()
          document.querySelector('#pdf-dl')?.setAttribute('download', document.title + '.pdf')
        }
      }
    %script{ src: 'https://unpkg.com/pagedjs@0.4.3/dist/paged.polyfill.js' }
    %style
      :plain
        @page {
          size: A4;
          margin: 18mm 15mm;
          @top-left     { content: string(doc-title); font-size: 8pt; color: #999; }
          @bottom-right { content: "Stranica " counter(page) " / " counter(pages); font-size: 8pt; color: #999; }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 10pt; line-height: 1.4; color: #222; }
        h1 { font-size: 14pt; margin-bottom: 8px; string-set: doc-title content(); }
        h2 { font-size: 12pt; margin-bottom: 6px; }
        h3 { font-size: 11pt; margin-bottom: 4px; }
        .header { display: flex; justify-content: space-between; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #333; }
        .header-left { flex: 1; }
        .header-right { text-align: right; }
        .header .company { font-size: 12pt; font-weight: bold; }
        .header .meta { font-size: 10pt; color: #555; }
        .section { margin-bottom: 14px; }
        .section-title { font-size: 10pt; font-weight: bold; background: #f0f0f0; padding: 4px 8px; margin-bottom: 6px; border-left: 3px solid #333; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 10pt; }
        /* Firefox + Paged.js can't start a multi-page <table> partway down a page -
           it bumps the whole table to the next page. Making table/thead/tbody block
           lets the row list fragment like normal blocks; each <tr> is a fixed-layout
           table so columns stay aligned. Chrome paginates identically. */
        table, thead, tbody { display: block; }
        tr { display: table; width: 100%; table-layout: fixed; border-collapse: collapse; break-inside: avoid; }
        th, td { padding: 4px 6px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background: #f5f5f5; font-weight: bold; border-bottom: 2px solid #999; }
        .num { text-align: right; width: 110px; }
        .col-n { width: 40px; }
        .center { text-align: center; }
        tr.total td { font-weight: bold; border-top: 2px solid #333; border-bottom: none; }
        .row { display: flex; margin-bottom: 3px; }
        .row .label { width: 200px; color: #555; }
        .row .value { flex: 1; font-weight: bold; }
        .signatures { display: flex; justify-content: space-between; margin-top: 40px; padding-top: 10px; }
        .signature-line { width: 200px; text-align: center; }
        .signature-line .line { border-top: 1px solid #333; margin-bottom: 4px; margin-top: 40px; }
        .signature-line .role { font-size: 10pt; color: #555; }
        .page-break { break-before: page; }
        .text-sm { font-size: 10pt; }
        .text-gray-500 { color: #777; }
        .bold { font-weight: bold; }
    / Screen-only preview chrome. Paged.js skips [media~='screen'] stylesheets, so
    / these rules survive (rules inside the processed <style> above get stripped).
    / Gives the Google-Docs look: gray canvas, white A4 sheets centered in a column.
    %style{ media: 'screen' }
      :plain
        html, body { background: #e8e8ea !important; }
        /* Paged.js moves the whole body into its page boxes, so #pdf-dl travels
           along - position: fixed keeps it pinned to the viewport wherever it
           lands. Screen-only, and PdfGenerator drops the node before printing. */
        #pdf-dl {
          position: fixed; right: 20px; top: 20px; z-index: 9999;
          background: #111; color: #fff; padding: 10px 16px; border-radius: 8px;
          font: 600 13px sans-serif; text-decoration: none;
          box-shadow: 0 2px 8px rgba(0, 0, 0, .3);
          display: inline-flex; align-items: center; gap: 7px;
        }
        /* Busy state while the server renders the PDF: dim the button, block
           further clicks (pointer-events beats the 1s JS release), show spinner. */
        #pdf-dl[aria-busy='true'] { opacity: .65; pointer-events: none; }
        #pdf-dl .pdf-dl-spinner {
          display: none; width: 13px; height: 13px; flex: none;
          border: 2px solid rgba(255, 255, 255, .35); border-top-color: #fff;
          border-radius: 50%; animation: pdf-dl-spin .7s linear infinite;
        }
        #pdf-dl[aria-busy='true'] .pdf-dl-spinner { display: inline-block; }
        @keyframes pdf-dl-spin { to { transform: rotate(360deg); } }
        .pagedjs_pages {
          display: flex !important;
          flex-direction: column;
          align-items: center;
          gap: 16px;
          padding: 28px 16px 56px;
          /* Preview-only zoom; print media (the PDF) is unaffected. zoom reflows,
             so page gaps stay correct - unlike transform: scale. */
          zoom: 1.2;
        }
        .pagedjs_page {
          background: #fff;
          box-shadow: 0 2px 14px rgba(0, 0, 0, .18);
          margin: 0 !important;
        }
  %body
    / Plain link, always in the markup - /<path>.pdf renders server-side, so the
    / button must not wait on (or be lost to) a Paged.js run that stalls.
    %a#pdf-dl{ href: @pdf_url, download: true }
      %span.pdf-dl-spinner{ 'aria-hidden': 'true' }
      %span.pdf-dl-label Preuzmi PDF
    = yield
    :javascript
      // Serve the PDF through fetch instead of native link navigation: a link
      // gives no completion event, so the button cannot show progress or stop
      // re-clicks, and every click re-runs the headless render. Delegated on
      // document because Paged.js reparents/clones the button during pagination.
      document.addEventListener('click', event => {
        const btn = event.target.closest('#pdf-dl')
        if (!btn) return
        event.preventDefault()
        if (btn.dataset.busy) return

        btn.dataset.busy = '1'
        btn.setAttribute('aria-busy', 'true')

        fetch(btn.href, { headers: { Accept: 'application/pdf' } })
          .then(res => {
            if (!res.ok) throw new Error(res.status)
            return res.blob()
          })
          .then(blob => {
            const name = btn.getAttribute('download')
            const url = URL.createObjectURL(blob)
            const link = document.createElement('a')
            link.href = url
            link.download = (name && !['download', 'true'].includes(name))
              ? name
              : (document.title || 'document') + '.pdf'
            document.body.appendChild(link)
            link.click()
            link.remove()
            setTimeout(() => URL.revokeObjectURL(url), 1000)
          })
          .catch(() => alert('PDF nije generiran. Pokušaj ponovno.'))
          .finally(() => {
            // Hold the lock a beat past completion so a fast double click cannot
            // start a second render, then release.
            setTimeout(() => {
              delete btn.dataset.busy
              btn.removeAttribute('aria-busy')
            }, 1000)
          })
      })
